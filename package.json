{
  "name": "@primate-inc/mono",
  "version": "1.0.0",
  "license": "MIT",
  "keywords": [
    "sass",
    "scss",
    "css",
    "design tokens",
    "figma",
    "style dictionary"
  ],
  "type": "module",
  "main": "mono.js",
  "files": [
    "mono.scss",
    "src/mono/**/*.scss",
    "src/scripts",
    "src/init"
  ],
  "bin": {
    "mono": "./mono.js"
  },
  "scripts": {
    "tokens": "node ./src/scripts/transformTokens.js",
    "sass:watch": "sass --watch local/main.scss:local/main.css --load-path=src/mono --no-source-map",
    "serve": "live-server local --watch=main.css,index.html --no-browser",
    "dev": "npm-run-all -p tokens sass:watch serve",
    "setup": "node mono.js tokens -p ./local && node mono.js init -p ./local"
  },
  "devDependencies": {
    "live-server": "^1.2.2",
    "npm-run-all": "^4.1.5",
    "sass": "^1.72.0"
  },
  "dependencies": {
    "ansis": "^3.2.0",
    "fs-extra": "^10.1.0",
    "meow": "^11.0.0",
    "path": "^0.12.7",
    "style-dictionary": "^4.3.3",
    "url": "^0.11.4"
  },
  "babel": {
    "plugins": [
      "@babel/plugin-proposal-class-properties"
    ]
  },
  "browserlist": [
    "IE11",
    "> 1%",
    "last 2 versions"
  ]
}
